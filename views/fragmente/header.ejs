<%# Task 5: fragment header decupat din index, inclus cu include() %>
<header>
    <h1 class="titlu-reflexie" data-text="Iverson Era">Iverson Era</h1>
    <nav id="main-nav">
        <input type="checkbox" id="ch-menu" />

        <label for="ch-menu" id="hamburger" aria-label="Deschide meniul principal">
            <div class="hamburger-lines">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span class="menu-text">Meniu</span>
        </label>

        <ul class="meniu">
            <li>
                <a href="/" class="menu-link">
                    <i class="fa-solid fa-house menu-icon"></i>
                    <span class="menu-text">Acasă</span>
                </a>
                <ul class="submenu">
                    <li><a href="#welcome">Bun venit</a></li>
                    <li><a href="#orar">Program</a></li>
                    <li><a href="#calendar">Calendar</a></li>
                    <li><a href="#anunturi">Anunțuri</a></li>
                </ul>
            </li>

            <!-- [Etapa 6] format-entitati - Meniu. Împărțirea pe categorii mari -->
            <li>
                <a href="/produse" class="menu-link">
                    <i class="fa-solid fa-layer-group menu-icon"></i>
                    <span class="menu-text">Produse</span>
                </a>
                <ul class="submenu">
                    <li><a href="/produse">Toate</a></li>
                    <% if (locals.categorii_menu) { %>
                        <% for (let categ of categorii_menu) { %>
                            <li><a href="/produse?categorie=<%= categ %>"><%= categ %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>

            <li>
                <a href="#noutati" class="menu-link">
                    <i class="fa-solid fa-layer-group menu-icon"></i>
                    <span class="menu-text">Noutăți</span>
                </a>
                <ul class="submenu">
                    <li><a href="#intro">Despre Noi</a></li>
                    <li><a href="#lansari">Lansări Noi</a></li>
                    <li><a href="#promotii">Promoții</a></li>
                    <li><a href="#produse">Produse</a></li>
                    <li><a href="#index-intrebari">FAQ</a></li>
                </ul>
            </li>

            <li>
                <a href="/oferte" class="menu-link">
                    <i class="fa-solid fa-tags menu-icon"></i>
                    <span class="menu-text">Oferte</span>
                </a>
            </li>

            <li class="menu-right">
                <a href="/cos" class="menu-link">
                    <i class="fa-solid fa-basket-shopping menu-icon"></i>
                    <span class="menu-text">Coș</span>
                </a>
            </li>
        </ul>
    </nav>
    <!-- [Bonus 2] Selector simplu pentru 3 teme memorate in localStorage. -->
    <div class="theme-switcher">
        <label for="tema-select" class="theme-switcher__label">Tema</label>
        <select id="tema-select" class="theme-switcher__select" aria-label="Alege tema site-ului">
            <option value="dark">Dark</option>
            <option value="light">Light</option>
            <option value="sepia">Sepia</option>
        </select>
    </div>
    <script>
        (function() {
            var selectTema = document.getElementById('tema-select');
            var temeValide = ['dark', 'light', 'sepia'];

            function aplicaTema(tema) {
                document.documentElement.classList.remove('tema-light', 'tema-sepia');
                if (tema === 'light') {
                    document.documentElement.classList.add('tema-light');
                } else if (tema === 'sepia') {
                    document.documentElement.classList.add('tema-sepia');
                }
                localStorage.setItem('tema', tema);
                selectTema.value = tema;
            }

            var temaSalvata = localStorage.getItem('tema');
            if (temeValide.indexOf(temaSalvata) === -1) {
                temaSalvata = 'dark';
            }
            aplicaTema(temaSalvata);

            selectTema.addEventListener('change', function() {
                aplicaTema(selectTema.value);
            });
        })();
    </script>
</header>
