<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head', { title: locals.title || 'Produse' }) %>
</head>
<body>
    <%- include('../fragmente/header.ejs') %><main>
    <h1>Produse Disponibile</h1>
    <div class="produse-container" style="display: flex; flex-wrap: wrap; gap: 20px;">
        <% if (locals.produse && produse.length > 0) { %>
            <% for (let prod of produse) { %>
                <article class="produs-card" style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; width: 250px;">
                    <img src="<%= prod.imagine %>" alt="<%= prod.nume %>" style="max-width: 100%; height: auto; border-radius: 4px;">
                    <h2><%= prod.nume %></h2>
                    <p><strong>Categorie:</strong> <span class="categorie-valoare"><%= prod.categorie_mare %></span></p>
                    <p><strong>Subcategorie:</strong> <%= prod.subcategorie %></p>
                    <p><strong>Pret:</strong> <%= prod.pret %> USD</p>
                    <a href="/produs/<%= prod.id %>" style="display: inline-block; margin-top: 10px; padding: 5px 10px; background: #ff5722; color: white; text-decoration: none; border-radius: 4px;">Vezi detalii</a>
                </article>
            <% } %>
        <% } else { %>
            <p>Nu exista produse disponibile momentan.</p>
        <% } %>
    </div>
</main>

    <%- include('../fragmente/footer.ejs') %>
</body>
</html>
